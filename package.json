{
  "name": "gitline",
  "productName": "Gitline",
  "version": "0.2.0",
  "description": "A desktop Git client for macOS, Windows and Linux",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false,
    "fsevents": false
  },
  "author": {
    "name": "Miot-Man",
    "email": "dattmoose995@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Miot-Man/gitline.git"
  },
  "build": {
    "appId": "com.github.miot-man.gitline",
    "productName": "Gitline",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "pacman"
      ],
      "category": "Development",
      "maintainer": "Miot-Man <dattmoose995@gmail.com>",
      "synopsis": "Desktop Git client",
      "executableName": "gitline"
    },
    "publish": {
      "provider": "github",
      "owner": "Miot-Man",
      "repo": "gitline"
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "git"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "libnotify",
        "xdg-utils",
        "at-spi2-core",
        "libsecret",
        "git"
      ]
    },
    "artifactName": "Gitline-${version}-${arch}.${ext}"
  },
  "homepage": "https://github.com/Miot-Man/gitline"
}
